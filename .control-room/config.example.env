# ============================================================
# .control-room/config.example.env — PLACEHOLDERS ONLY
#
# Copy this somewhere outside the repository, fill it in there, and
# load it into the environment before starting the server:
#
#     set -a; . ~/control-room.env; set +a
#     node .control-room/cli.mjs serve
#
# DO NOT fill this file in and commit it. Nothing in this repository
# may hold a credential: the whole tree is published by the
# deployment, and a secret committed and later removed is still in
# the history and still in every clone.
#
# `node .control-room/cli.mjs check` prints the configuration it
# read and every reason the server would refuse to start.
# ============================================================


# ---------------------------------------------------------- where

# development | production
# Production refuses the local provider, requires an https origin,
# and puts Secure on the session cookie.
CONTROL_ROOM_ENV=development

# Loopback unless this is production with an identity provider
# configured. The refusal is in config.mjs, not a default: SESSION 20
# measured what an overridable default is worth.
CONTROL_ROOM_HOST=127.0.0.1
CONTROL_ROOM_PORT=7802

# The origin a browser actually reaches this on. REQUIRED in
# production, and it must be https. It is what the Origin header is
# checked against and what the OIDC redirect URI is built from.
# CONTROL_ROOM_PUBLIC_ORIGIN=https://control-room.example.org


# ---------------------------------------------------------- who

# oidc | local
#   oidc  — an OpenID Connect identity provider. The only one
#           permitted in production. MFA, password policy, account
#           recovery and revocation are the provider's.
#   local — development only. Loopback only. Two independent
#           refusals in config.mjs enforce both.
CONTROL_ROOM_AUTH_PROVIDER=local

# The identity provider. The issuer must serve
# /.well-known/openid-configuration and must declare itself as this
# same issuer in it.
# CONTROL_ROOM_OIDC_ISSUER=https://your-tenant.example-idp.com
# CONTROL_ROOM_OIDC_CLIENT_ID=replace-with-the-client-id

# Optional. Omit it for a public client — the flow uses PKCE either
# way. If your provider issues one, put the value in the environment;
# never in this file, never in the repository, never on a command
# line.
# CONTROL_ROOM_OIDC_CLIENT_SECRET=

# CONTROL_ROOM_OIDC_SCOPES=openid email profile

# For a LOCAL test identity provider on loopback only. It permits an
# http issuer, and config.mjs refuses it outright in production —
# trusting an unsigned discovery document fetched over http is
# trusting the network to say who the user is.
# CONTROL_ROOM_OIDC_ALLOW_INSECURE=1

# The redirect URI to register with your provider is:
#     <CONTROL_ROOM_PUBLIC_ORIGIN>/auth/callback


# ---------------------------------------------------------- how long

# Absolute session lifetime, and idle timeout. The idle one must be
# the shorter, or it can never fire.
CONTROL_ROOM_SESSION_TTL_MINUTES=480
CONTROL_ROOM_SESSION_IDLE_MINUTES=30


# ---------------------------------------------------------- where things live

# Private state: the operator registry, sessions, the audit trail,
# review notes. Defaults to .control-room/state/, which is
# git-ignored. Point it at a directory outside the repository if you
# would rather not rely on an ignore rule.
# CONTROL_ROOM_STATE_DIR=/var/lib/control-room

# The SHARED observability store, so a Control Room decision can be
# correlated with the agent run that produced the proposal. Defaults
# to agent/observability/runs/.
# CONTROL_ROOM_TRACE_DIR=

# The proposal record store and the decision ledger. Both default to
# this repository's own directories and both are machine-level
# configuration: no route reads them, and no request can influence
# them. They are configurable so the security suite can exercise a
# real approval without writing into the repository's one ledger.
# CONTROL_ROOM_RECORDS_DIR=
# CONTROL_ROOM_DECISIONS_DIR=
